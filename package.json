{
  "name": "synthsara-node-zero",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local-first, auditable proof node connected to the Genesis O-Series gateway.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "conformance:deployment": "node scripts/deployment-conformance.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run check && node scripts/run-release-tests.mjs",
    "test:wire:strict": "node --test tests/rtme-wire.test.mjs",
    "test:wire:inventory": "node scripts/report-wire-status.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
